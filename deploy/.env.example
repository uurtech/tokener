# tokener production settings (read by deploy/docker-compose.yml). install.sh fills these in for you.

# Public host name pointing at this server (A/AAAA record). Caddy gets a Let's Encrypt certificate for it.
# Use ":80" for a plain-HTTP proof of concept without a domain.
DOMAIN=claude-gw.example.com

# Admin console login (/admin). Long and random.
ADMIN_TOKEN=
# Encrypts upstream keys stored from the console. Keep it stable: changing it makes stored keys unreadable.
KEY_POOL_SECRET=

# Optional: the gateway's own Amazon Bedrock credentials. Not needed if you only use pool keys (admin → Keys).
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: read-only pool keys from config instead of the console.
# PROVIDER_KEYS_JSON=[{"label":"org-a","kind":"anthropic","key":"sk-ant-..."}]

# Optional: Slack/Discord/generic webhook for key and budget alerts (also editable in the console).
# ALERT_WEBHOOK_URL=

# Optional: single sign-on for the admin console (OpenID Connect: Google, Okta, Entra ID, Auth0, Keycloak...).
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_ALLOWED_EMAILS=

# Policy defaults (the console overrides these once saved).
# BUDGET_ACTION=warn
# ROUTE_AUXILIARY_MODEL=anthropic.claude-haiku-4-5
