# Copy to gateway/.env and fill in. Loaded by `npm run local` only; never committed (.gitignore / .dockerignore).
# Option A — Bedrock API key (simplest; works for Mantle, Runtime and the model catalog):
AWS_BEARER_TOKEN_BEDROCK=
# Option B — IAM access keys. The identity needs: bedrock-mantle:CreateInference, bedrock-mantle:CountTokens,
# bedrock:InvokeModel*, bedrock:ListFoundationModels, bedrock:ListInferenceProfiles.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary credentials
AWS_REGION=us-east-1
ADMIN_TOKEN=archeon-admin
# Optional policy defaults (the admin UI overrides these once saved):
# EFFORT_MODE=off
# ROUTE_AUXILIARY_MODEL=anthropic.claude-haiku-4-5
