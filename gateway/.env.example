# Copy to gateway/.env and fill in. Loaded by `npm run local` only; never committed (.gitignore / .dockerignore).
# Option A — Bedrock API key (simplest; works for Mantle, Runtime and the model catalog):
AWS_BEARER_TOKEN_BEDROCK=
# Option B — IAM access keys. The identity needs: bedrock-mantle:CreateInference, bedrock-mantle:CountTokens,
# bedrock:InvokeModel*, bedrock:ListFoundationModels, bedrock:ListInferenceProfiles.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary credentials
AWS_REGION=us-east-1
# Leave ADMIN_TOKEN empty to get a random token printed at start.
ADMIN_TOKEN=
# Optional policy defaults (the admin UI overrides these once saved):
# EFFORT_MODE=off
# ROUTE_AUXILIARY_MODEL=anthropic.claude-haiku-4-5
# Upstream key pool (optional). Add keys in the admin UI → Keys, or list read-only ones here.
# Several Anthropic and/or Bedrock API keys behind one endpoint, with rotation and automatic failover.
# KEY_POOL_SECRET=               # encrypts stored keys; `npm run local` creates data/keypool.secret if empty
# PROVIDER_KEYS_JSON=[{"label":"team-a","kind":"anthropic","key":"sk-ant-..."},{"label":"acct-2","kind":"bedrock","key":"ABSK...","region":"us-west-2"}]
